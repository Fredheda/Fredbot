# Copy to backend/.env and fill in values.

# Any LiteLLM model string: https://docs.litellm.ai/docs/providers
#   openai/gpt-4o-mini | azure/<deployment-name> | anthropic/claude-sonnet-4-5 | ...
FREDBOT_DEFAULT_MODEL=openai/gpt-4o-mini
# FREDBOT_SYSTEM_PROMPT="You are Fredbot, ..."
FREDBOT_CORS_ORIGINS=["http://localhost:5173"]

# Provider credentials (only the ones for the provider you use), read by LiteLLM.
OPENAI_API_KEY=
# AZURE_API_KEY=
# AZURE_API_BASE=https://<resource>.openai.azure.com
# AZURE_API_VERSION=2024-10-21
